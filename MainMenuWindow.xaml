<Window x:Class="Tower_Defense.MainMenuWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tower_Defense"
      mc:Ignorable="d" 
      Width="1600" Height="900" MaxWidth="1600" MaxHeight="900" MinWidth="1600" MinHeight="900"
      Title="Main Menu" WindowStyle="ToolWindow">
	<Window.Background>
		<ImageBrush ImageSource="/images/MainMenuBackground.png"  Stretch="UniformToFill"/>
	</Window.Background>

	<Canvas>
		<Button Style="{StaticResource PlainButton}" Content="Singleplayer" Click="StartSingleplayerGame_Click" Canvas.Left="50" Canvas.Top="600" 
		Cursor="Hand" FontFamily="Comic Sans MS" FontSize="24" Foreground="White" Height="80" Width="250">
			<Button.Background>
				<ImageBrush ImageSource="/images/BlueRoundedButton.png"/>
			</Button.Background>
		</Button>
		<Button Style="{StaticResource PlainButton}" Content="Multiplayer" Click="OpenMultiplayerOptions_Click" Canvas.Left="50" Canvas.Top="690" 
		Cursor="Hand" FontFamily="Comic Sans MS" FontSize="24" Foreground="White" Height="80" Width="250">
			<Button.Background>
				<ImageBrush ImageSource="/images/BlueRoundedButton.png"/>
			</Button.Background>
		</Button>
		
		<Popup x:Name="MulitplayerOptionsPopup" AllowsTransparency="True" StaysOpen="True" Placement="Center">
			<Border CornerRadius="20" Padding="20">
				<Grid Height="250" Width="400">
					<Image Source="/images/4_3PopupBackground.png" Stretch="Fill"/>
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Choose an option" FontFamily="Comic Sans MS" FontSize="36" FontWeight="Bold" Foreground="White" 
								   HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="20"/>

						<StackPanel Orientation="Horizontal" Margin="20,5,20,20" HorizontalAlignment="Center" VerticalAlignment="Bottom">
							<Button Style="{StaticResource PlainButton}" Content="Host Game" FontFamily="Comic Sans MS" FontSize="24" Padding="10"
								Click="HostButton_Click" Foreground="White" Margin="10" Height="75" Width="150" Cursor="Hand">
								<Button.Background>
									<ImageBrush ImageSource="/images/BlueRoundedButton.png" Stretch="Fill"/>
								</Button.Background>
							</Button>
							<Button Style="{StaticResource PlainButton}" Content="Join Game" FontFamily="Comic Sans MS" FontSize="24" Padding="10"
								Click="JoinButton_Click" Foreground="White" Margin="20" Height="75" Width="150" Cursor="Hand">
								<Button.Background>
									<ImageBrush ImageSource="/images/BlueRoundedButton.png" Stretch="Fill"/>
								</Button.Background>
							</Button>
						</StackPanel>
					</StackPanel>
				</Grid>
			</Border>
		</Popup>
	</Canvas>
</Window>
